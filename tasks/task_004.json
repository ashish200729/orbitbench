{
  "id": "task_004",
  "title": "Design Twitter",
  "language": "typescript",
  "difficulty": "hard",
  "source": "LeetCode #355",
  "description": "Implement a simplified Twitter in TypeScript named `Twitter`.\n\n`postTweet(userId, tweetId)` composes a new tweet. `getNewsFeed(userId)` returns the IDs of the 10 most recent tweets in the user's feed (their own tweets and tweets from everyone they follow), ordered MOST RECENT FIRST. `follow(followerId, followeeId)` and `unfollow(followerId, followeeId)` manage following (a user cannot unfollow themselves; following is idempotent). Tweet recency is determined by the global order in which postTweet calls occur.\n\nclass Twitter {\n  postTweet(userId: number, tweetId: number): void {}\n  getNewsFeed(userId: number): number[] {}\n  follow(followerId: number, followeeId: number): void {}\n  unfollow(followerId: number, followeeId: number): void {}\n}",
  "function_signature": "class Twitter { postTweet(userId: number, tweetId: number): void {} getNewsFeed(userId: number): number[] {} follow(followerId: number, followeeId: number): void {} unfollow(followerId: number, followeeId: number): void {} }",
  "constraints": [
    "1 <= userId, tweetId <= 10^4",
    "At most 3*10^4 calls total",
    "Feed returns at most 10 tweets, most recent first"
  ],
  "test_cases": [
